# Salin ke .env (untuk dev lokal) atau isi sebagai Environment Variables
# di project Vercel. Kosongkan keduanya kalau frontend disajikan dari
# origin yang sama dengan backend (mis. parth-dl serve lokal).

# URL backend parth-dl di Render, tanpa trailing slash.
VITE_API_BASE=https://REPLACE-WITH-YOUR-BACKEND.onrender.com

# Harus sama persis dengan PARTH_DL_API_KEY yang diset di backend.
# Catatan: ini nilai publik di frontend (kebaca dari devtools/bundle),
# cuma penghalang orang iseng, bukan autentikasi kuat.
VITE_API_KEY=REPLACE-WITH-PARTH_DL_API_KEY
